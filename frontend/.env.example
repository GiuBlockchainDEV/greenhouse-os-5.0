# GAIA — Google AI key (server-side on Vercel; never expose to the browser)
# On Vercel: Project Settings → Environment Variables → enable Production + Preview, then redeploy.
GEMINI_API_KEY=
# Accepted aliases if you already use Google / Vercel AI SDK naming:
# GOOGLE_GENERATIVE_AI_API_KEY=
# GOOGLE_API_KEY=

# Opzionali
GEMINI_MODEL=gemini-3.5-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# Backend Python (opzionale — simulazione WS, export, Supabase CRUD)
# VITE_API_BASE_URL=https://your-backend.example.com

# Supabase (opzionale)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
